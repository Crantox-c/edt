{
  "expo": {
    "name": "EDT",
    "slug": "monapp2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "geiiedt",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.km.geiiedt",
      "icon": {
        "light": "./assets/images/app-icon/AppIcon-Standard-1024.png",
        "dark": "./assets/images/app-icon/AppIcon-Dark-1024.png",
        "tinted": "./assets/images/app-icon/AppIcon-Tinted-1024.png"
      }
    },
    "android": {
      "package": "com.km.geiiedt",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#38BDF8"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.km.geiiedt.widgets",
          "groupIdentifier": "group.com.km.geiiedt",
          "widgets": [
            {
              "name": "NextCourseWidget",
              "displayName": "Prochain cours",
              "description": "Cours en cours ou à venir avec compte à rebours, salle et progression.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/next-course-widget.tsx"
              }
            },
            {
              "name": "DayAgendaWidget",
              "displayName": "Journée",
              "description": "Programme détaillé de votre journée avec horaires, salles et badges.",
              "supportedFamilies": [
                "systemMedium"
              ],
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/day-agenda-widget.tsx"
              }
            },
            {
              "name": "WeekOverviewWidget",
              "displayName": "Semaine & DS",
              "description": "Charge hebdomadaire, prochains créneaux et alerte DS.",
              "supportedFamilies": [
                "systemLarge"
              ],
              "ios": {
                "supportedFamilies": [
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/week-overview-widget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
